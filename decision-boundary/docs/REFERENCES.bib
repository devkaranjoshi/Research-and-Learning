@inproceedings{keskar2017largebatch,
  title     = {On Large-Batch Training for Deep Learning: Generalization Gap and Sharp Minima},
  author    = {Keskar, Nitish Shirish and Mudigere, Dheevatsa and Nocedal, Jorge and Smelyanskiy, Mikhail and Tang, Ping Tak Peter},
  booktitle = {International Conference on Learning Representations (ICLR)},
  year      = {2017},
  eprint    = {1609.04836},
  archivePrefix = {arXiv},
  note      = {Foundational paper: large-batch SGD finds sharper minima with worse generalization. Iconic 1D loss-interpolation plot.}
}

@inproceedings{dinh2017sharp,
  title     = {Sharp Minima Can Generalize For Deep Nets},
  author    = {Dinh, Laurent and Pascanu, Razvan and Bengio, Samy and Bengio, Yoshua},
  booktitle = {International Conference on Machine Learning (ICML)},
  year      = {2017},
  eprint    = {1703.04933},
  archivePrefix = {arXiv},
  note      = {Theoretical pushback: reparameterization can convert flat minima into sharp ones without changing function value, so "sharpness in parameter space" is not a well-defined invariant.}
}

@inproceedings{andriushchenko2023modern,
  title     = {A Modern Look at the Relationship Between Sharpness and Generalization},
  author    = {Andriushchenko, Maksym and Croce, Francesco and M{\"u}ller, Maximilian and Hein, Matthias and Flammarion, Nicolas},
  booktitle = {International Conference on Machine Learning (ICML)},
  year      = {2023},
  eprint    = {2302.07011},
  archivePrefix = {arXiv},
  note      = {Empirical pushback: parameter-space sharpness only weakly causally linked to generalization. Reproduces sharp minima that generalize fine. Motivates separating param-space (P5 Hessian) from input-space (P3 adversarial) probes.}
}

